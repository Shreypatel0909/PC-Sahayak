# Copy this file to ".env" and fill in your key (git-ignored).
# Alternatively, put the key in .streamlit/secrets.toml (see that example file).
# Non-secret settings live in config/config.yaml (see config/config.example.yaml).

# Groq API key — free at https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# --- Optional path overrides (normally leave unset; configure in config.yaml) ---
